{
  "description": "Block tool calls when plan usage is at or above the threshold",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/usage-guard.sh"
          }
        ]
      }
    ]
  }
}
